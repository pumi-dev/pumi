{
  "name": "pumi-git",
  "version": "0.1.0",
  "license": "GPL-3.0-or-later",
  "description": "Git in the sidebar: stage, commit, history and diffs.",
  "keywords": [
    "git",
    "source-control",
    "diff",
    "history",
    "sidebar"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/pumi-dev/pumi",
    "directory": "plugins/git"
  },
  "type": "module",
  "main": "src/main.ts",
  "scripts": {
    "test": "bun test",
    "check": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "typescript": "5.9.3"
  },
  "pumi": {
    "name": "git",
    "owner": "pumi_dev",
    "api": 1,
    "icon": "icon.png",
    "uses": [
      "files",
      "processes"
    ],
    "contributes": {
      "options": {
        "date_format": {
          "type": "string",
          "default": "relative",
          "choices": [
            "relative",
            "absolute"
          ],
          "labels": [
            "How long ago",
            "Date and time"
          ],
          "label": "Dates",
          "group": "Git",
          "desc": "How the history dates a commit: how long ago it was, or the day and minute it was."
        },
        "show_author": {
          "type": "boolean",
          "default": true,
          "label": "Authors",
          "group": "Git",
          "desc": "Show each commit's author in the history."
        },
        "diff": {
          "type": "string",
          "default": "",
          "scope": "tab",
          "label": "Diff",
          "group": "Git",
          "desc": "What a diff tab shows, as the page set it: a side of the work tree, a file of it, or a commit."
        }
      },
      "commands": [
        {
          "id": "toggle",
          "title": "Git: show the changes and the history"
        }
      ],
      "keys": [
        {
          "key": "<C-S-g>",
          "command": "toggle"
        }
      ],
      "slots": {
        "panel": {
          "component": "Git",
          "title": "Git",
          "icon": "git_branch"
        }
      },
      "blocks": [
        {
          "id": "diff",
          "title": "Diff",
          "icon": "git_branch"
        }
      ]
    },
    "activation": [
      "onStartup"
    ]
  }
}
