{
  "compilerOptions": {
    "target": "ESNext",
    "module": "Preserve",
    "moduleResolution": "bundler",
    "lib": ["ESNext"],
    "types": ["bun"],
    "typeRoots": ["../../app/node_modules/@types"],
    "strict": true,
    "noImplicitAny": false,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "paths": {
      "pumi": ["../../app/types/index.ts"],
      "pumi/jsx-runtime": ["../../app/types/jsx-runtime.ts"],
      "pumi/jsx-dev-runtime": ["../../app/types/jsx-dev-runtime.ts"],
      "react": ["../../app/node_modules/@types/react"]
    },
    "jsx": "react-jsx",
    "jsxImportSource": "pumi"
  },
  "include": ["src", "test"]
}
